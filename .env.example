# =============================================================================
# Attendance Management System - Environment Configuration
# =============================================================================
# Copy this file to .env (git-ignored) and fill in real values.
# Never commit .env or any file containing real passwords/credentials.
# =============================================================================

# --- MySQL database (required) ---
ATTENDANCE_DB_URL=jdbc:mysql://localhost:3306/attendance_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
ATTENDANCE_DB_USER=attendance_app
ATTENDANCE_DB_PASS=change_me_in_env

# --- Optional SMTP for defaulter email notifications ---
# Leave these blank to disable email notifications (app still works).
ATTENDANCE_SMTP_HOST=
ATTENDANCE_SMTP_PORT=587
ATTENDANCE_SMTP_USER=
ATTENDANCE_SMTP_PASS=
ATTENDANCE_SMTP_AUTH=false
ATTENDANCE_SMTP_STARTTLS=true

# --- Application ---
SERVER_PORT=8080
